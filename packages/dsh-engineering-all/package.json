{
  "name": "@linxin666/dsh-engineering-all",
  "description": "dsh-engineering 聚合包：工程能力插件全家桶 + 统一管理面板（设置 > 插件 > 插件配置）。首个成员：dsh-beyond-workscope（外部成员，注册与配置仍走 dsh-web-ui 渠道，本包只做概览与入口，避免重复注册冲突）。",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@linxin666/dsh-beyond-workscope-eng": "link:../dsh-beyond-workscope-eng",
    "@linxin666/dsh-nas": "link:../dsh-nas",
    "@linxin666/dsh-office": "link:../dsh-office",
    "@linxin666/dsh-mail": "link:../dsh-mail"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "lightningcss": "1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "@linxin666/dsh-client-ui-web-ui-settings": "link:../../../dsh-web-ui/packages/dsh-web-ui-settings"
  },
  "license": "BSD-3-Clause"
}
